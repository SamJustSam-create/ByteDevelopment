{
  "description": "Emails you the moment someone submits the contact form, with their details and message.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Enquiry"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_enquiry_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alert": {
          "call": "send_email",
          "with": {
            "template_name": "EnquiryNotification",
            "to": "s.x.moloney@gmail.com",
            "category": "transactional",
            "description": "Emails you a new website enquiry with the sender's details and message",
            "variables": {
              "name": "${ .trigger.data.name }",
              "email": "${ .trigger.data.email }",
              "service": "${ .trigger.data.service }",
              "budget": "${ .trigger.data.budget }",
              "message": "${ .trigger.data.message }",
              "submitted": "${ .trigger.data.created_date }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email the enquiry",
            "description": "To your inbox, straight away"
          }
        }
      }
    ]
  },
  "name": "New Enquiry Alert"
}