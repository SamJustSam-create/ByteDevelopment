{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person enquiring"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Reply address"
    },
    "service": {
      "type": "string",
      "enum": [
        "Web app or website",
        "Automation or integration",
        "Review or rescue",
        "Not sure yet"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "gray"
      ],
      "description": "What they think they need"
    },
    "budget": {
      "type": "string",
      "enum": [
        "Under $2k",
        "$2k - $5k",
        "$5k - $15k",
        "$15k or more",
        "Not sure yet"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green",
        "gray"
      ],
      "description": "Rough budget range, optional"
    },
    "message": {
      "type": "string",
      "description": "What they are trying to build, fix or automate"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "won",
        "closed"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "green",
        "gray"
      ],
      "default": "new",
      "description": "Where the enquiry is up to"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}